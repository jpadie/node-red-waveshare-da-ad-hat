[
    {
        "id": "multi_adc_example",
        "type": "tab",
        "label": "Multi-ADC Monitoring Example",
        "disabled": false,
        "info": "Example flow demonstrating the multi-ADC comparison node with multiple sensors"
    },
    {
        "id": "multi_adc_node",
        "type": "waveshare-ad-multi",
        "z": "multi_adc_example",
        "name": "Sensor Monitor",
        "comparisons": [
            {
                "name": "Temperature Sensor",
                "channel": 0,
                "differential": false,
                "negChannel": 8,
                "gain": 1,
                "buffered": true,
                "sps": 100
            },
            {
                "name": "Pressure Sensor",
                "channel": 1,
                "differential": false,
                "negChannel": 8,
                "gain": 2,
                "buffered": true,
                "sps": 50
            },
            {
                "name": "Voltage Differential",
                "channel": 2,
                "differential": true,
                "negChannel": 3,
                "gain": 4,
                "buffered": false,
                "sps": 250
            },
            {
                "name": "Current Sensor",
                "channel": 4,
                "differential": false,
                "negChannel": 8,
                "gain": 8,
                "buffered": true,
                "sps": 100
            }
        ],
        "emissionFrequency": 2.0,
        "outputFormat": "aggregated",
        "x": 200,
        "y": 200,
        "wires": [["debug_output"]]
    },
    {
        "id": "debug_output",
        "type": "debug",
        "z": "multi_adc_example",
        "name": "Multi-ADC Output",
